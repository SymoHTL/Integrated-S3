<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Provider contract tests, reusable state-store fakes, and checksum helpers for IntegratedS3.</Description>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!--
      Shipped helper library only uses [Fact] (xunit.core) and Assert (xunit.assert); see
      StorageProviderContractTests.cs. Reference those two packages directly instead of the full
      `xunit` meta-package so consumers of the published IntegratedS3.Testing NuGet package do not
      inherit the analyzer/build surface of the meta-package. See issue #144.
    -->
    <PackageReference Include="xunit.core" />
    <PackageReference Include="xunit.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntegratedS3.Abstractions\IntegratedS3.Abstractions.csproj" />
    <ProjectReference Include="..\IntegratedS3.Protocol\IntegratedS3.Protocol.csproj" />
    <ProjectReference Include="..\IntegratedS3.Core\IntegratedS3.Core.csproj" />
  </ItemGroup>
</Project>
